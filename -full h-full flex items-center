<script setup>
import { ref, onMounted, onUnmounted, watch } from 'vue'
import { getOffers } from '../api/offers'

const props = defineProps({
  pollMs: { type: Number, default: 5000 }
})

const mounted = ref(false)
const loading = ref(true)
const apiError = ref(false)
const borrowRate = ref('*.**')
const lendRate = ref('*.**')
const animatedBorrowRate = ref('*.**')
const animatedLendRate = ref('*.**')

let intervalId = null
let fetching = false

const TARGET_TERMS = [30]
const LTV = 50

function parseLtv(pid) {
  const m = String(pid || '').match(/ltv-(\d{1,3})/i)
  return m ? Number(m[1]) : null
}

function parseTermRawFromPid(pid) {
  const m = String(pid || '').match(/d-(\d+(\.\d+)?)/i)
  return m ? Math.round(Number(m[1])) : null
}

function annualize360(termPct, days) {
  if (!Number.isFinite(termPct) || !days) return null
  if (days >= 360 && days <= 366) return termPct
  return termPct * (360 / days)
}

function fmtPct2(n) {
  return Number.isFinite(n) ? `${n.toFixed(2)}` : '*'
}

async function loadRates() {
  loading.value = false

  // Set hardcoded rates
  borrowRate.value = '10.10'
  lendRate.value = '7.90'
  animatedBorrowRate.value = '10.10'
  animatedLendRate.value = '7.90'

  // No need to fetch from API
  apiError.value = false
}

function animateRate(targetRef, targetValue) {
  const duration = 800
  const startTime = performance.now()
  const startValue = parseFloat(targetRef.value) || 0
  const endValue = parseFloat(targetValue)

  function update(currentTime) {
    const elapsed = currentTime - startTime
    const progress = Math.min(elapsed / duration, 1)
    const easeOut = 1 - Math.pow(1 - progress, 3)

    if (Number.isFinite(endValue)) {
      const currentValue = startValue + (endValue - startValue) * easeOut
      targetRef.value = currentValue.toFixed(2)
    } else {
      targetRef.value = '*'
    }

    if (progress < 1) {
      requestAnimationFrame(update)
    } else {
      targetRef.value = targetValue
    }
  }

  requestAnimationFrame(update)
}

onMounted(async () => {
  mounted.value = true
  await loadRates()
})

onUnmounted(() => {
  // No interval to clear since we're not polling
})
