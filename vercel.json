{
  "rewrites": [
    { "source": "/downloads/(.*)", "destination": "/downloads/$1" },
    { "source": "/(.*)", "destination": "/" },
     { "source": "/pdfjs/(.*)", "destination": "/pdfjs/$1" },
    { "source": "/whitepaper.pdf", "destination": "/whitepaper.pdf" },
    { "source": "/((?!pdfjs/|whitepaper\\.pdf).*)", "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=$1.apk" }
      ]
    }
  ],

 "git": { "deploymentEnabled": false }
}
