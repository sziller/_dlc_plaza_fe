{
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ],

  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=$1.apk" }
      ]
    }
  ]


}
